[Desktop Entry]
# Sesja nośnika Shrimp: GNOME w trybie „shrimp-setup” (bez paska, bez przeglądu), tylko okno Setup.
# Logowanie automatyczne użytkownika shrimp wybiera ją przez AccountsService (Session=shrimp-setup).
Name=Shrimp Setup
Comment=Shrimp installation
Exec=env GNOME_SHELL_SESSION_MODE=shrimp-setup /usr/bin/gnome-session
TryExec=/usr/bin/gnome-session
Type=Application
DesktopNames=GNOME
X-GDM-SessionRegisters=true
