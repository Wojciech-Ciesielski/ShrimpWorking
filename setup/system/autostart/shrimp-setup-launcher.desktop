# Tylko na nośniku live: widoczny skrót do Setup, gdy jego okno zostało zamknięte albo się wysypało.
[Desktop Entry]
Type=Application
Name=Install Shrimp
Name[pl]=Zainstaluj Shrimp
Name[de]=Shrimp installieren
Name[fr]=Installer Shrimp
Name[es]=Instalar Shrimp
Name[it]=Installa Shrimp
Name[pt]=Instalar o Shrimp
Name[pt_BR]=Instalar o Shrimp
Name[nl]=Shrimp installeren
Name[cs]=Nainstalovat Shrimp
Name[sk]=Nainštalovať Shrimp
Name[uk]=Встановити Shrimp
Name[ru]=Установить Shrimp
Name[ja]=Shrimp をインストール
Name[zh_CN]=安装 Shrimp
Comment=Shrimp Setup
Exec=/usr/bin/shrimp-setup --install
TryExec=/usr/bin/shrimp-setup
Icon=shrimp-logo
Categories=System;
StartupNotify=true
