<?xml version="1.0" encoding="utf-8"?>
<!-- Shrimp Beta: live ISO on openSUSE Leap 16.1 + GNOME.
     Build: tools/build-iso.sh (local, needs Docker) or the "Build ISO" GitHub workflow. -->
<image schemaversion="8.5" name="Shrimp" displayname="Shrimp">
    <description type="system">
        <author>Shrimp</author>
        <contact>wciesielski.personal@icloud.com</contact>
        <specification>Shrimp Beta live system (openSUSE Leap 16.1, GNOME)</specification>
    </description>
    <preferences>
        <version>0.1.0</version>
        <packagemanager>zypper</packagemanager>
        <locale>pl_PL</locale>
        <keytable>pl</keytable>
        <timezone>Europe/Warsaw</timezone>
        <rpm-excludedocs>true</rpm-excludedocs>
        <rpm-check-signatures>false</rpm-check-signatures>
        <bootsplash-theme>shrimp</bootsplash-theme>
        <bootloader-theme>shrimp</bootloader-theme>
        <type image="iso" primary="true" flags="overlay"
              hybridpersistent="true" hybridpersistent_filesystem="ext4"
              firmware="uefi" mediacheck="false"
              kernelcmdline="splash quiet loglevel=3 rd.udev.log_level=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false vt.global_cursor_default=0"
              editbootconfig="edit_boot_config.sh"
              volid="SHRIMP_LIVE" publisher="Shrimp" application_id="Shrimp">
            <bootloader name="grub2" output_console="gfxterm" input_console="console" video_mode="1920x1080" timeout="1" timeout_style="hidden"/>
        </type>
    </preferences>
    <users>
        <user password="shrimp" pwdformat="plain" home="/root" name="root" groups="root"/>
        <user password="shrimp" pwdformat="plain" home="/home/shrimp" name="shrimp" realname="Shrimp" groups="users,wheel"/>
    </users>
    <!-- tools/build-iso.sh and the workflow pass the real Leap 16.1 URL with set-repo -->
    <repository type="rpm-md" alias="leap-oss" imageinclude="true">
        <source path="https://download.opensuse.org/distribution/leap/16.1/repo/oss/x86_64/"/>
    </repository>
    <packages type="image">
        <!-- base -->
        <package name="distribution-release"/>
        <package name="systemd"/>
        <package name="udev"/>
        <package name="kernel-default"/>
        <package name="kernel-firmware-all"/>
        <package name="dracut"/>
        <package name="dracut-kiwi-live"/>
        <package name="grub2"/>
        <package name="grub2-x86_64-efi"/>
        <package name="grub2-i386-pc"/>
        <package name="shim"/>
        <package name="glibc-locale"/>
        <package name="timezone"/>
        <package name="sudo"/>
        <package name="zypper"/>
        <package name="NetworkManager"/>
        <package name="btrfsprogs"/>
        <package name="snapper"/>
        <package name="transactional-update"/>
        <package name="flatpak"/>
        <package name="curl"/>
        <package name="unzip"/>
        <package name="fontconfig"/>
        <!-- boot splash -->
        <package name="plymouth"/>
        <package name="plymouth-dracut"/>
        <package name="plymouth-plugin-script"/>
        <package name="plymouth-plugin-label"/>
        <!-- sound and video: PipeWire only (Linu(x), codecs in config.sh) -->
        <package name="pipewire"/>
        <package name="wireplumber"/>
        <package name="pipewire-pulseaudio"/>
        <package name="pipewire-alsa"/>
        <!-- GNOME -->
        <namedCollection name="gnome_basic"/>
        <package name="gdm"/>
        <package name="gnome-shell"/>
        <package name="gnome-session"/>
        <package name="gnome-control-center"/>
        <package name="gnome-shell-extensions-common"/>
        <!-- DING (Desktop Icons) needs the GnomeDesktop 3.0 introspection data -->
        <package name="typelib-1_0-GnomeDesktop-3_0"/>
        <!-- Desktop Icons and Dash to Dock need gvfs for trash:// -->
        <package name="gvfs"/>
        <package name="gvfs-backends"/>
        <package name="nautilus"/>
        <package name="gnome-console"/>
        <package name="gnome-keyring"/>
        <package name="xdg-user-dirs-gtk"/>
        <package name="xdg-desktop-portal-gnome"/>
        <package name="adwaita-icon-theme"/>
        <package name="gjs"/>
        <!-- Quick Settings (system menu, top right): volume and microphone sliders need the
             PipeWire stack, the Bluetooth toggle needs bluez, battery and power state need upower.
             Packages that may be named differently in Leap 16.1 are installed in config.sh. -->
        <package name="pipewire"/>
        <package name="pipewire-pulseaudio"/>
        <package name="pipewire-alsa"/>
        <package name="wireplumber"/>
        <package name="bluez"/>
        <package name="upower"/>
        <!-- Polish translations (lang packages are only recommended, so list them) -->
        <package name="gnome-shell-lang"/>
        <package name="gdm-lang"/>
        <package name="gnome-control-center-lang"/>
        <package name="gnome-session-lang"/>
        <package name="nautilus-lang"/>
        <package name="gnome-shell-extensions-common-lang"/>
        <package name="gtk4-lang"/>
        <package name="libadwaita-lang"/>
        <!-- Shrimp Setup (tools/build-setup.sh puts the program into the image):
             window = GTK4 + WebKitGTK 6 (web processes run in bubblewrap), installer = Agama 24 -->
        <package name="libgtk-4-1"/>
        <package name="libwebkitgtk-6_0-4"/>
        <!-- Shrimp Apps (store, built by tools/build-setup.sh): libflatpak + libadwaita; Steam needs gamemode and controller rules -->
        <package name="libflatpak0"/>
        <package name="libadwaita-1-0"/>
        <package name="steam-devices"/>
        <package name="gamemode"/>
        <package name="bubblewrap"/>
        <package name="xdg-dbus-proxy"/>
        <package name="polkit"/>
        <package name="agama"/>
        <package name="agama-yast"/>
        <package name="agama-web-ui"/>
        <package name="agama-cli"/>
        <!-- build-time helpers used by config.sh (icons, GRUB fonts, shell theme) -->
        <package name="rsvg-convert"/>
        <package name="glib2-tools"/>
        <package name="glib2-devel"/>
        <package name="dconf"/>
    </packages>
    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="glibc-locale-base"/>
        <package name="ca-certificates"/>
        <package name="ca-certificates-mozilla"/>
        <package name="cracklib-dict-full"/>
    </packages>
</image>
